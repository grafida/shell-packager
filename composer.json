{
    "name": "grafida/shell-packager",
    "description": "Build and packaging tooling for apps on the Grafida desktop shell: PHAR building, runtime fetch-and-verify, macOS/Windows/Linux bundling, signing and notarisation.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/grafida/shell-packager",
    "authors": [
        {
            "name": "Nicholas K. Dionysopoulos",
            "homepage": "https://www.dionysopoulos.me/about-me"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-phar": "*",
        "ext-zlib": "*",
        "seld/phar-utils": "^1.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "Grafida\\ShellPackager\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grafida\\ShellPackager\\Tests\\": "tests"
        }
    },
    "bin": [
        "bin/shell-packager"
    ],
    "scripts": {
        "test": "phpunit",
        "linter:check": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    }
}

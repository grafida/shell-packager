{
    "manifest": "shell.json",
    "phar": {
        "entrypoint": "bin/worker.php",
        "include": [
            {
                "directory": "bin",
                "name": "worker.php"
            },
            {
                "directory": "src",
                "name": "*.php"
            },
            {
                "directory": "assets"
            },
            {
                "directory": "vendor",
                "name": "*.php",
                "notName": [
                    "*Test.php"
                ]
            }
        ],
        "ini": {
            "memory_limit": "321M",
            "opcache.enable": false,
            "display_errors": "stderr"
        }
    },
    "linux": {
        "name": "test-app",
        "desktop": "app.desktop",
        "icons": {
            "48": "icons/48.png",
            "16": "icons/16.png"
        },
        "files": {
            "LICENSE.txt": "LICENSE.txt"
        },
        "package": {
            "maintainer": "Packager Test <packager@example.invalid>",
            "license": "MIT",
            "homepage": "https://example.invalid/test-app",
            "description": "A fixture app for the packager's tests."
        },
        "output": "dist/{name}-{version}-linux-{debarch}.tar.gz",
        "appimage": {
            "updateInformation": "gh-releases-zsync|fixture|test-app|latest|test-app-*-linux-{debarch}.AppImage.zsync"
        },
        "pkgbuild": {
            "source": "https://example.invalid/dl/{name}-{version}-linux-{debarch}.tar.gz",
            "description": "A fixture's 'test' app",
            "url": "https://example.invalid",
            "license": [
                "MIT"
            ],
            "maintainer": "Fixture Maintainer <fixture@example.invalid>",
            "depends": [
                "libsecret"
            ],
            "optdepends": [
                "wl-clipboard: paste on Wayland"
            ]
        }
    },

{
    "manifest": "shell.json",
    "phar": {
        "entrypoint": "bin/worker.php",
        "include": [
            {
                "directory": "bin",
                "name": "worker.php"
            },
            {
                "directory": "src",
                "name": "*.php"
            },
            {
                "directory": "assets"
            },
            {
                "directory": "vendor",
                "name": "*.php",
                "notName": [
                    "*Test.php"
                ]
            }
        ],
        "ini": {
            "memory_limit": "321M",
            "opcache.enable": false,
            "display_errors": "stderr"
        }
    },
    "linux": {
        "name": "test-app",
        "desktop": "app.desktop",
        "icons": {
            "48": "icons/48.png",
            "16": "icons/16.png"
        },
        "files": {
            "LICENSE.txt": "LICENSE.txt"
        },
        "output": "dist/{name}-{version}-linux-{debarch}.tar.gz"
    },
    "runtimes": {
        "shell": {
            "url": "https://github.com/grafida/shell/releases/download/0.1.0/grafida-shell-linux-{arch}",
            "sha256": {

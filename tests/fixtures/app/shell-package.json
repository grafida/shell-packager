{
    "manifest": "shell.json",
    "phar": {
        "entrypoint": "bin/worker.php",
        "include": [
            {
                "directory": "bin",
                "name": "worker.php"
            },
            {
                "directory": "src",
                "name": "*.php"
            },
            {
                "directory": "assets"
            },
            {
                "directory": "vendor",
                "name": "*.php",
                "notName": [
                    "*Test.php"
                ]
            }
        ],
        "ini": {
            "memory_limit": "321M",
            "opcache.enable": false,
            "display_errors": "stderr"
        }
    },
    "linux": {
        "name": "test-app",
        "desktop": "app.desktop",
        "icons": {
            "48": "icons/48.png",
            "16": "icons/16.png"
        },
        "files": {
            "LICENSE.txt": "LICENSE.txt"
        },
        "output": "dist/{name}-{version}-linux-{debarch}.tar.gz"
    },
    "runtimes": {
        "linux": {
            "shell": {
                "url": "https://github.com/grafida/shell/releases/download/0.2.0/grafida-shell-linux-{arch}",
                "sha256": {
                    "x86_64": "e215ac9f47d343c87083c5f981f6a1a1aa1a9b6b6f2edd18892d23675150a7c1",
                    "aarch64": "e991f9fb7236b708130c8abb95324c162221684c8d98298928eb88c515b6ec3c"
                }
            },
            "launcher": {
                "url": "https://github.com/grafida/shell/releases/download/0.2.0/grafida-launcher-linux-{arch}",
                "sha256": {
                    "x86_64": "f0a4a785d002d9b323723ba7c75dc600ad67fe3b70c4d3e21bbb9f52b6cceaa6",
                    "aarch64": "d0f298e5ad20ff50aa0a364c31cc9db3219dc1c4f486915344d18ce4c3be58ad"
                }
            },
            "sfx": {
                "url": "https://github.com/grafida/phpmicro/releases/download/sfx-20261109.16/linux-{arch}.standard.sfx",
                "sha256": {
                    "x86_64": "45607f6142ab76333ccb80ebfc08d4412552b9e0cf43ae83c8a278057e17b1e4",
                    "aarch64": "cfefff8e185372c5264454d672df0e02a6e219a47a376a376b7dc62724caa242"
                }
            }
        },
        "macos": {
            "shell": {
                "url": "https://github.com/grafida/shell/releases/download/0.2.0/grafida-shell-macos-arm64",
                "sha256": {
                    "aarch64": "b24598ae8062614e19e9dac1c2851b90e739ee006323edd0ef810b54dab1045f"
                }
            },
            "sfx": {
                "url": "https://github.com/grafida/phpmicro/releases/download/sfx-20261109.15/macos-aarch64.standard.sfx",
                "sha256": {
                    "aarch64": "046be1292371b1b59498c5df123956c02079e704dd5877d116b8385412134af4"
                }
            }
        }
    },
    "macos": {
        "icon": "icons/app.icns",
        "infoPlist": {
            "NSHumanReadableCopyright": "A fixture <for> \"tests\" & checks",
            "LSApplicationCategoryType": "public.app-category.developer-tools"
        },
        "resources": {
            "LICENSE.txt": "LICENSE.txt"
        },
        "dmg": {
            "background": "icons/dmg-background.png",
            "volumeIcon": "icons/app.icns"
        },
        "app": "dist/{name}.app",
        "output": "dist/{name}-{version}-macos-{debarch}.dmg"
    }
}

#!/usr/bin/env php
<?php

/**
 * Grafida Shell — packaging tooling.
 *
 * @copyright Copyright (c) 2026 Nicholas K. Dionysopoulos
 * @license   MIT; see LICENSE
 */

declare(strict_types=1);

const SHELL_PACKAGER_VERSION = '0.1.0-dev';

$command = $argv[1] ?? 'help';

switch ($command) {
    case '--version':
    case 'version':
        fwrite(STDOUT, 'shell-packager ' . SHELL_PACKAGER_VERSION . PHP_EOL);
        exit(0);

    case 'help':
    case '--help':
        $version = SHELL_PACKAGER_VERSION;
        fwrite(STDOUT, <<<TXT
            shell-packager {$version}

            Usage: shell-packager <command> [options]

            No commands are implemented yet; see https://github.com/grafida/grafida/issues/82.

            TXT);
        exit(0);

    default:
        fwrite(STDERR, "shell-packager: unknown command '{$command}'\n");
        exit(64);
}
